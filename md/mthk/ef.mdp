;
integrator              = md
dt                      = 0.002
nsteps                  = 50000000
nstxtcout               = 1000
nstcalcenergy           = 100
nstenergy               = 1000
nstlog                  = 1000
;
cutoff-scheme           = Verlet
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
DispCorr                = EnerPres
;
tcoupl                  = V-rescale
tc_grps                 = System
tau_t                   = 1.0 
ref_t                   = 310.15
;
constraints             = h-bonds
constraint_algorithm    = LINCS
continuation            = yes
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = System
;
electric-field-z        = 0.1 0 0 0 ; # E = electric field along z in V/nm
